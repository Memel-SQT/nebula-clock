{
  "name": "@nebula-clock/core",
  "version": "1.1.0",
  "private": true,
  "description": "Framework-free business logic for Nebula Clock: timer state machine, storage, stats, i18n, notifications.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./timer": "./src/timer/index.ts",
    "./storage": "./src/storage/index.ts",
    "./stats": "./src/stats/index.ts",
    "./config": "./src/config/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./sounds": "./src/sounds/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "howler": "^2.2.4",
    "i18next": "^23.16.5"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@vitest/coverage-v8": "^2.1.5",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
