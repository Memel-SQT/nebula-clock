{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    // The main process is Node; the preload script runs in the renderer and
    // legitimately reads `window.location`, so DOM types are needed too.
    "lib": ["ES2022", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tsup.config.ts"]
}
