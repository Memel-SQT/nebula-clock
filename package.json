{
  "name": "nebula-clock",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Nebula Clock - a privacy-first Pomodoro time manager for web (PWA) and desktop (Electron).",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nebula-clock/web dev",
    "dev:desktop": "pnpm --filter @nebula-clock/desktop dev",
    "build": "pnpm --filter @nebula-clock/web build",
    "build:desktop": "pnpm --filter @nebula-clock/desktop build",
    "preview": "pnpm --filter @nebula-clock/web preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "test:coverage": "pnpm --filter @nebula-clock/core test:coverage",
    "test:e2e": "pnpm --filter @nebula-clock/web test:e2e",
    "clean": "rimraf \"**/dist\" \"**/dist-electron\" \"**/release\" \"**/coverage\" \"**/.turbo\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
